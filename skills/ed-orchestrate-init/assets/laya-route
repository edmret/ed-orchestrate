#!/usr/bin/env python3
"""laya-route — harness-neutral lane/TDD/context router backed by Laya.

Installed by ed-orchestrate-init (setup_graph_dag.py --laya). This is the
project's own copy from then on: tune QUESTIONS / LAYER_RULES / *_CONTEXT below
to this repo's paths and gotcha area files, guided by the outcome log.

Laya (local `laya-serve`, default http://localhost:8000) answers ATOMIC yes/no
questions about a change request. A deterministic combiner below turns those
answers plus path facts into a decision. Path facts always override Laya. If Laya
is unreachable the path facts decide alone and anything uncertain goes to `graph`.

Why atomic questions: measured on 10 real-shaped requests, broad questions
("fast or graph?") scored 6-7/10 with every miss unsafe (graph -> fast);
single-aspect `noul` questions scored 9-10/10.

Usage (any harness, plain shell):
  laya-route --request-en "Make the totals bar sticky" [--request "<original>"]
             [--files a.ts,b.html | --git-diff [BASE]] [--task TASK-123]
  laya-route outcome --id <decision-id> [--value correct|wrong-lane|wrong-tdd|wrong-context]
             [--tier tier-ok|tier-too-low|tier-too-high] [--model-used M] [--attempts N]
             [--escalated] [--note "..."]
  laya-route export [--out-dir DIR] [--stats] [--min-lane N] [--min-tier N]
             # join decisions+outcomes into fine-tune datasets (lane-*.jsonl, tier-*.jsonl);
             # --stats prints the readiness report only (lane_ready / tier_ready)

Prints one JSON object: {id, lane, tdd, context, answers, facts, reason, laya}.
lane: graph | fast | ui-iterate | ask     tdd: first | defer

Coder MODEL TIER (only when .orchestrate/agents.json has coder.modelTiers): adds
{model_tier, tier_reason, tier_mode, models, dispatch_model[, tier_vote, tier_answers]}.
  model_tier: a tier name from coder.modelTiers (cheapest first) or "strong" (= the coder's own
  model). Cheap-first: a capability HARD GATE, a wide fence, or a decisive Laya answer => strong;
  otherwise the cheapest tier. The planner may pick a middle tier from each tier's `useWhen`.
  Mode = LAYA_TIER_MODE env, else coder.tierPolicy.mode, else "shadow":
    off     no tier fields
    shadow  tier computed and logged, dispatch_model stays "strong"
    on      dispatch_model follows model_tier
  Roll out shadow -> on using the outcome log (references/laya-routing.md, "Fine-tuning it").
Every decision is appended to <memory-dir>/laya/decisions.jsonl (fine-tune dataset).
"""
import argparse
import datetime as dt
import json
import os
import re
import subprocess
import sys
import urllib.error
import urllib.request
import uuid

MEMORY_DIR = ".ai-memory"  # rewritten at install time to the project's shared task-memory dir
LAYA_URL = os.environ.get("LAYA_URL", "http://localhost:8000")
TIMEOUT_S = float(os.environ.get("LAYA_TIMEOUT", "30"))  # CPU inference slows sharply under machine load
RETRIES = int(os.environ.get("LAYA_RETRIES", "1"))
GOTCHAS = MEMORY_DIR + "/knowledge/gotchas"
HI, LO = 0.65, 0.35  # uncertainty band for deciding questions

# ---- PROJECT TUNING --------------------------------------------------------
# Atomic questions. Keep each one single-aspect: broad ones measured unreliable.
# Add a domain question (e.g. "Does this request involve the billing screens?")
# only together with a TOPIC_CONTEXT entry for it.
QUESTIONS = {
    "visual_only": "Is this request only about appearance: layout, styling, spacing, colors, text labels or markup?",
    "pure_logic": "Does this request create or change a calculation, formatting, parsing or validation function?",
    "state_or_api": "Does this request involve a data store, HTTP calls, backend API or mock server?",
    "navigation": "Does this request add or change routes, navigation or route guards?",
    "auth_rbac": "Does this request involve login, authentication, roles or permissions?",
    "forms": "Does this request involve form fields, form validation or user input handling?",
    "e2e_mock": "Does this request involve e2e test mocks, fake backend data or test fixtures?",
    "testing": "Is this request mainly about writing or fixing automated tests?",
}
# Questions whose confident "yes" forces the graph lane.
DECIDING = ("state_or_api", "navigation", "auth_rbac")

# Topic answer -> gotcha area files (under GOTCHAS) an agent should read.
# Only files that actually exist are emitted, so listing a not-yet-created area is safe.
TOPIC_CONTEXT = {
    "visual_only": ["ui.md"],
    "forms": ["forms.md"],
    "state_or_api": ["state-api.md"],
    "navigation": ["routing.md"],
    "auth_rbac": ["routing.md"],
    "e2e_mock": ["testing.md"],
    "testing": ["testing.md"],
}

# Path conventions -> layer. First match wins, so the risky layers come first
# (a store's spec is still a store change).
LAYER_RULES = [
    ("navigation", re.compile(r"(\.routes?\.[jt]sx?$|/routes?/|router|guard|resolver|middleware|permission)", re.I)),
    ("state_api", re.compile(r"(\.store\.|\.service\.|/stores?/|/services?/|/msw/|/mocks?/|/api/|gateway|adapter|interceptor|repository|\.port\.|/generated/|/migrations?/)", re.I)),
    ("test", re.compile(r"(\.spec\.|\.test\.|^e2e/|/e2e/|/__tests__/|^tests?/)", re.I)),
    ("logic", re.compile(r"(/utils?/|\.utils?\.|\.helpers?\.|\.pipe\.|parser|validator|formatter)", re.I)),
    ("styles", re.compile(r"\.(s?css|sass|less)$", re.I)),
    ("template", re.compile(r"\.(html|vue|svelte)$", re.I)),
    ("component", re.compile(r"(\.component\.[jt]s$|\.[jt]sx$)", re.I)),
    ("config", re.compile(r"(^\.github/|^tools/|\.json$|\.ya?ml$|\.toml$|\.config\.|tsconfig|Dockerfile)", re.I)),
]
LAYER_CONTEXT = {
    "navigation": ["routing.md"],
    "state_api": ["state-api.md"],
    "test": ["testing.md"],
    "logic": ["testing.md"],
    "styles": ["ui.md"],
    "template": ["ui.md"],
    "component": ["ui.md"],
}
GRAPH_LAYERS = {"navigation", "state_api", "config"}
TDD_LAYERS = {"logic", "state_api", "navigation"}
VISUAL_LAYERS = {"styles", "template", "component"}

# Coder model tiers. Used only when coder.modelTiers exists in .orchestrate/agents.json.
# Capability hard gates (NOT the process-weight lane gates): any path hit => "strong".
# Tune these first when the outcome log shows tier-too-low — they are free and deterministic.
TIER_HARD_GATES = [
    ("store/state", re.compile(r"(\.store\.|/stores?/)")),
    ("guard/route/middleware", re.compile(r"(\.routes?\.[jt]sx?$|guard|interceptor|resolver|middleware)", re.I)),
    ("generated/API client", re.compile(r"(^|/)(api|generated)/")),
    ("build/CI config", re.compile(
        r"(^|/)(package(-lock)?\.json|tsconfig[^/]*\.json|[^/]*\.config\.[jt]s|Dockerfile)$|^\.github/")),
    ("auth/permissions", re.compile(r"(permission|auth)", re.I)),
    ("migrations", re.compile(r"/migrations?/")),
]
WIDE_FENCE = 8  # files in the scope fence at or above which the task goes straight to "strong"
HI_TIER_WITH_FILES = 0.9  # Laya bar to override path facts for the tier when files are known
# Extra atomic questions used ONLY for the tier. A decisive yes can only push UP to "strong".
TIER_QUESTIONS = {
    "money_math": "Does this request involve money, decimal, rounding or unit-conversion arithmetic?",
    "debugging": "Is this request about finding the unknown root cause of a bug or a flaky behavior?",
}
TIER_DECIDING = ("state_or_api", "navigation", "auth_rbac", "money_math", "debugging")
TIER_CHOICE_INSTRUCTIONS = ("Which model tier should implement this coding task? "
                            "Choose the cheapest that can do it reliably.")
TIER_STRONG_CRITERIA = ("Hard or risky: new state or store logic, API contracts, routing or guards, "
                        "auth, concurrency, money math, cross-cutting refactors, or an unclear root cause.")
# ---- END PROJECT TUNING ----------------------------------------------------


def repo_root():
    try:
        return subprocess.check_output(["git", "rev-parse", "--show-toplevel"], text=True,
                                       stderr=subprocess.DEVNULL).strip()
    except Exception:
        return os.getcwd()


def git_diff_files(base):
    cmd = ["git", "diff", "--name-only"] + ([base] if base else ["HEAD"])
    files = subprocess.check_output(cmd, text=True).split()
    files += subprocess.check_output(["git", "ls-files", "--others", "--exclude-standard"], text=True).split()
    return sorted(set(files))


def layer_of(path):
    for layer, rx in LAYER_RULES:
        if rx.search(path):
            return layer
    return "other"


def load_tiers(root):
    """Read coder.modelTiers/tierPolicy from .orchestrate/agents.json.

    Returns None when the project has no tiers (tiering disabled), else
    {"order": [names cheapest first], "models": {name|"strong": label}, "useWhen": {...},
     "mode": off|shadow|on, "start": name|"strong"}.
    """
    try:
        with open(os.path.join(root, ".orchestrate", "agents.json")) as fh:
            coder = json.load(fh)["roles"]["coder"]
    except (OSError, KeyError, ValueError):
        return None
    tiers = [t for t in (coder.get("modelTiers") or []) if isinstance(t, dict) and t.get("name")]
    if not tiers:
        return None

    def label(b, base):
        harness = b.get("harness") or base.get("harness")
        provider = b.get("provider") if "provider" in b or b.get("harness") else base.get("provider")
        ref = "%s/%s" % (provider, b["model"]) if provider else b["model"]
        return "%s:%s" % (harness, ref) if harness else ref

    policy = coder.get("tierPolicy") or {}
    mode = os.environ.get("LAYA_TIER_MODE", policy.get("mode") or "shadow").strip().lower()
    return {
        "order": [t["name"] for t in tiers],
        "models": dict({t["name"]: label(t, coder) for t in tiers}, strong=label(coder, coder)),
        "useWhen": {t["name"]: t.get("useWhen") or "" for t in tiers},
        "mode": mode if mode in ("off", "shadow", "on") else "shadow",
        "start": policy.get("start") or "strong",
    }


def decide_tier(tiers, files, answers, extra, laya_ok):
    """Cheap-first: hard gate / wide fence / decisive Laya / unknown situation => "strong"."""
    gated = sorted({name for f in files for name, rx in TIER_HARD_GATES if rx.search(f)})
    if gated:
        return "strong", "hard gate: " + ", ".join(gated)
    if len(files) >= WIDE_FENCE:
        return "strong", "wide fence: %d files" % len(files)
    if laya_ok:
        scores = dict(answers)
        scores.update(extra.get("tier_answers", {}))
        # With a scope fence, path facts are the better witness: a Laya "hot" must be near-certain
        # to override them. Without files, Laya is all we have, so the normal band applies.
        bar = HI_TIER_WITH_FILES if files else HI
        hot = [k for k in TIER_DECIDING if scores.get(k, 0) > bar]
        if hot:
            return "strong", "laya: " + ",".join(hot)
    elif not files:
        return tiers["start"], "unknown: no files and laya unavailable -> policy start"
    return tiers["order"][0], "no hard gate; cheapest tier" + ("" if files else " (no files given)")


def ask_laya(state, tiers=None):
    """Returns (answers, extra). `answers` = noul scores for QUESTIONS. `extra` holds the tier
    answers + Choice vote (empty without tiers, or if the server rejects the tier questions).
    Replace this function to move the classifier to another model/machine."""
    questions = {k: {"type": "noul", "instructions": v} for k, v in QUESTIONS.items()}
    if tiers:
        questions.update({k: {"type": "noul", "instructions": v} for k, v in TIER_QUESTIONS.items()})
        criteria = {n: tiers["useWhen"].get(n) or n for n in tiers["order"]}
        criteria["strong"] = TIER_STRONG_CRITERIA
        questions["tier_choice"] = {"type": "choice", "instructions": TIER_CHOICE_INSTRUCTIONS,
                                    "criteria": criteria}
    try:
        res = _laya_post(state, questions)
    except urllib.error.HTTPError as e:
        if not tiers or e.code not in (400, 422):
            raise
        tiers = None  # server rejected the tier questions: fall back to the plain ones
        res = _laya_post(state, {k: v for k, v in questions.items() if k in QUESTIONS})
    answers = {k: round(float(res["answers"][k]["noul"]), 3) for k in QUESTIONS}
    extra = {}
    if tiers:
        extra["tier_answers"] = {k: round(float(res["answers"][k]["noul"]), 3) for k in TIER_QUESTIONS}
        vote = res["answers"].get("tier_choice") or {}
        if vote.get("probabilities"):
            extra["tier_vote"] = {"choice": vote.get("choice"), "probabilities": vote["probabilities"]}
    return answers, extra


def _laya_post(state, questions):
    body = json.dumps({"state": state, "model": "english", "questions": questions})
    req = urllib.request.Request(LAYA_URL.rstrip("/") + "/v1/systemone", body.encode(),
                                 {"content-type": "application/json"})
    token = os.environ.get("LAYA_TOKEN")
    if token:
        req.add_header("authorization", "Bearer " + token)
    with urllib.request.urlopen(req, timeout=TIMEOUT_S) as r:
        return json.load(r)


def decide(answers, layers, file_count, root="."):
    reasons = []
    ls = set(layers.values())
    graph_layers = ls & GRAPH_LAYERS

    # Lane
    if graph_layers:
        lane = "graph"
        reasons.append("path facts: %s layer touched" % ",".join(sorted(graph_layers)))
    elif file_count >= 4:
        lane = "graph"
        reasons.append("path facts: %d files" % file_count)
    elif answers is None:
        if ls and ls <= VISUAL_LAYERS:
            lane = "ui-iterate"
            reasons.append("laya down; all touched files are visual")
        elif ls and ls <= (VISUAL_LAYERS | {"logic", "test"}):
            lane = "fast"
            reasons.append("laya down; only visual/logic/test files")
        else:
            lane = "graph"
            reasons.append("laya down and no decisive path facts -> safe default")
    else:
        hot = [k for k in DECIDING if answers[k] > HI]
        unsure = [k for k in DECIDING if LO <= answers[k] <= HI]
        if hot:
            lane = "graph"
            reasons.append("laya: %s" % ",".join(hot))
        elif unsure and not ls:
            lane = "ask"
            reasons.append("laya unsure on %s and no files to settle it" % ",".join(unsure))
        elif unsure:
            lane = "graph" if ls - (VISUAL_LAYERS | {"logic", "test"}) else "fast"
            reasons.append("laya unsure on %s; path facts settle -> %s" % (",".join(unsure), lane))
        elif answers["pure_logic"] <= 0.5 and (not ls or ls <= VISUAL_LAYERS):
            # No logic, no graph signal, nothing but visual files: iterate on the UI.
            lane = "ui-iterate"
            reasons.append("laya: no logic/state/nav (visual_only=%.2f)" % answers["visual_only"])
        else:
            lane = "fast"
            reasons.append("small non-visual change")

    # TDD: logic always test-first; defer only when purely visual.
    logic_hit = bool(ls & TDD_LAYERS) or (answers is not None and answers["pure_logic"] > 0.5)
    tdd = "first" if logic_hit or lane == "graph" else "defer"
    if lane == "ui-iterate" and answers is not None and answers["pure_logic"] > 0.5:
        tdd = "first"

    # Context manifest. Lane and files decide context; Laya scores only decide the
    # lane. A graph lane legitimately widens context from topic answers; a fast /
    # ui-iterate lane stays minimal (topics only when there are no files to go on) —
    # the outcome log showed high state/API scores on a pure UI tweak dragging in
    # graph-wide context otherwise.
    ctx = ["00-core.md"]
    if answers is not None and (lane in ("graph", "ask") or not ls):
        for k, files in TOPIC_CONTEXT.items():
            if answers[k] > 0.5:
                ctx += files
    for layer in ls:
        ctx += LAYER_CONTEXT.get(layer, [])
    if tdd == "first":
        ctx.append("testing.md")
    seen, context = set(), []
    for f in ctx:
        if f in seen:
            continue
        seen.add(f)
        # 00-core is always named; area files only once they exist (created on first gotcha).
        if f == "00-core.md" or os.path.exists(os.path.join(root, GOTCHAS, f)):
            context.append("%s/%s" % (GOTCHAS, f))
    return lane, tdd, context, "; ".join(reasons)


def log(root, record):
    path = os.path.join(root, MEMORY_DIR, "laya", "decisions.jsonl")
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "a") as fh:
        fh.write(json.dumps(record, ensure_ascii=False) + "\n")


def cmd_route(a):
    root = repo_root()
    files = [f.strip() for f in a.files.split(",") if f.strip()] if a.files else []
    if a.git_diff is not None:
        files = git_diff_files(a.git_diff or None)
    layers = {f: layer_of(f) for f in files}
    state = {"request_en": a.request_en}
    if files:
        state["files"] = files[:40]
    tiers = load_tiers(root)
    if tiers and tiers["mode"] == "off":
        tiers = None
    laya_status, answers, extra = "ok", None, {}
    for attempt in range(RETRIES + 1):
        try:
            answers, extra = ask_laya(state, tiers)
            if attempt:
                laya_status = "ok (after %d retry)" % attempt
            break
        except (urllib.error.URLError, OSError, KeyError, ValueError) as e:
            laya_status = "unavailable: %s" % (getattr(e, "reason", None) or e)
            # Retry only a timeout (busy CPU); a refused connection means Laya is really down.
            if "timed out" not in str(laya_status):
                break
    lane, tdd, context, reason = decide(answers, layers, len(files), root)
    out = {
        "id": uuid.uuid4().hex[:12],
        "lane": lane,
        "tdd": tdd,
        "context": context,
        "answers": answers,
        "facts": {"file_count": len(files), "layers": sorted(set(layers.values()))},
        "reason": reason,
        "laya": laya_status,
    }
    if tiers:
        tier, tier_reason = decide_tier(tiers, files, answers or {}, extra, answers is not None)
        dispatch_tier = tier if tiers["mode"] == "on" else "strong"
        out.update({
            "model_tier": tier,
            "tier_reason": tier_reason,
            "tier_mode": tiers["mode"],
            "models": tiers["models"],
            "dispatch_model": tiers["models"].get(dispatch_tier),
        })
        for key in ("tier_vote", "tier_answers"):
            if extra.get(key):
                out[key] = extra[key]
    if not a.no_log:
        log(root, dict(out, kind="decision", ts=dt.datetime.now().isoformat(timespec="seconds"),
                       task=a.task, request_en=a.request_en, request=a.request, files=files))
    print(json.dumps(out, ensure_ascii=False, indent=2))


def cmd_outcome(a):
    rec = {"kind": "outcome", "id": a.id, "value": a.value, "note": a.note,
           "ts": dt.datetime.now().isoformat(timespec="seconds")}
    for key, val in (("tier", a.tier), ("model_used", a.model_used), ("attempts", a.attempts)):
        if val is not None:
            rec[key] = val
    if a.escalated:
        rec["escalated"] = True
    log(repo_root(), rec)
    print(json.dumps({k: v for k, v in rec.items() if k not in ("kind", "note", "ts")} | {"logged": True}))


def _read_log(path):
    """Read the append-only log tolerantly: (records, malformed_count). Never raises."""
    try:
        with open(path, "r", encoding="utf-8") as fh:
            raw = fh.read()
    except OSError:
        return [], 0
    records, malformed = [], 0
    for line in raw.splitlines():
        if not line.strip():
            continue
        try:
            rec = json.loads(line)
            if not isinstance(rec, dict):
                raise ValueError("not a JSON object")
            records.append(rec)
        except (ValueError, TypeError):
            malformed += 1
    return records, malformed


def _index_outcomes(records, decisions):
    """Join outcomes to decisions.

    Several outcomes of the same id and dimension: keep the LATEST by order in
    file; a differing earlier value flags a conflict. Returns
    (lane, tier, conflicts, orphans, newest_ts).
    """
    lane, tier = {}, {}
    lane_conflict, tier_conflict = set(), set()
    orphans, newest_ts = 0, ""
    for i, rec in enumerate(records):
        if rec.get("kind") != "outcome":
            continue
        ts = rec.get("ts") or ""
        if ts > newest_ts:
            newest_ts = ts
        oid = rec.get("id")
        if oid not in decisions:
            orphans += 1
        value = rec.get("value")
        if value is not None:
            prev = lane.get(oid)
            if prev and prev["value"] != value:
                lane_conflict.add(oid)
            lane[oid] = {"out": rec, "value": value, "index": i}
        tier_value = rec.get("tier")
        if tier_value is not None:
            prev = tier.get(oid)
            if prev and prev["value"] != tier_value:
                tier_conflict.add(oid)
            tier[oid] = {"out": rec, "value": tier_value, "index": i}
    return lane, tier, len(lane_conflict) + len(tier_conflict), orphans, newest_ts


def _export_input(dec):
    inp = {"request": dec.get("request"), "request_en": dec.get("request_en"),
           "files": dec.get("files") or []}
    if dec.get("facts") is not None:
        inp["facts"] = dec["facts"]
    return inp


def _lane_row(dec, entry):
    return {
        "id": dec.get("id"),
        "input": _export_input(dec),
        "predicted": {k: dec.get(k) for k in ("lane", "tdd", "context", "answers", "reason")},
        "verdict": entry["value"],
        "note": entry["out"].get("note"),
    }


def _tier_row(dec, entry):
    out = entry["out"]
    predicted = {}
    for k in ("model_tier", "tier_reason", "tier_answers", "tier_vote", "dispatch_model", "tier_mode"):
        if dec.get(k) is not None:
            predicted[k] = dec[k]
    return {
        "id": dec.get("id"),
        "input": _export_input(dec),
        "predicted": predicted,
        "verdict": entry["value"],
        "model_used": out.get("model_used"),
        "attempts": out.get("attempts"),
        "escalated": bool(out.get("escalated")),
        "note": out.get("note"),
    }


def _write_jsonl(path, rows):
    with open(path, "w", encoding="utf-8") as fh:
        for row in rows:
            fh.write(json.dumps(row, ensure_ascii=False) + "\n")


def cmd_export(a):
    root = repo_root()
    mem = os.path.join(root, MEMORY_DIR)
    log_path = os.path.join(mem, "laya", "decisions.jsonl")
    out_dir = a.out_dir or os.path.join(mem, "laya", "export")
    if not os.path.isabs(out_dir):
        out_dir = os.path.join(root, out_dir)
    records, malformed = _read_log(log_path)
    decisions = {rec["id"]: rec for rec in records
                 if rec.get("kind") == "decision" and rec.get("id")}
    lane, tier, conflicts, orphans, newest_ts = _index_outcomes(records, decisions)
    ids = sorted(decisions)
    lane_rows = [_lane_row(decisions[i], lane[i]) for i in ids if i in lane]
    tier_rows = [_tier_row(decisions[i], tier[i]) for i in ids if i in tier]

    lane_verdicts, lane_counts = {}, {}
    for row in lane_rows:
        lane_verdicts[row["verdict"]] = lane_verdicts.get(row["verdict"], 0) + 1
        ln = row["predicted"].get("lane")
        lane_counts[ln] = lane_counts.get(ln, 0) + 1
    tier_verdicts = {}
    for row in tier_rows:
        tier_verdicts[row["verdict"]] = tier_verdicts.get(row["verdict"], 0) + 1

    unlabeled = [i for i in ids
                 if i not in lane and i not in tier
                 and newest_ts and (decisions[i].get("ts") or "") < newest_ts]
    shadow = sum(1 for i in ids
                 if decisions[i].get("tier_mode") == "shadow"
                 and decisions[i].get("model_tier") is not None and i not in tier)
    correct = lane_verdicts.get("correct", 0)
    report = {
        "log": log_path,
        "out_dir": out_dir,
        "total_decisions": len(decisions),
        "malformed": malformed,
        "orphans": orphans,
        "conflicts": conflicts,
        "lane": {
            "rows": len(lane_rows),
            "by_verdict": lane_verdicts,
            "by_lane": lane_counts,
            "accuracy": round(correct / len(lane_rows), 4) if lane_rows else 0.0,
        },
        "tier": {"rows": len(tier_rows), "by_verdict": tier_verdicts},
        "shadow_without_outcome": shadow,
        "unlabeled_ids": unlabeled,
        "min_lane": a.min_lane,
        "min_tier": a.min_tier,
        "lane_ready": len(lane_rows) >= a.min_lane,
        "tier_ready": len(tier_rows) >= a.min_tier,
        "written": None,
    }
    if not a.stats:
        os.makedirs(out_dir, exist_ok=True)
        stamp = dt.date.today().strftime("%Y%m%d")
        lane_path = os.path.join(out_dir, "lane-%s.jsonl" % stamp)
        tier_path = os.path.join(out_dir, "tier-%s.jsonl" % stamp)
        _write_jsonl(lane_path, lane_rows)
        _write_jsonl(tier_path, tier_rows)
        report["written"] = {"lane": lane_path, "tier": tier_path}
    print(json.dumps(report, ensure_ascii=False, indent=2, sort_keys=True))
    return 0


def main(argv):
    if argv and argv[0] == "export":
        p = argparse.ArgumentParser(prog="laya-route export",
                                    description="join decisions with outcomes into fine-tune datasets")
        p.add_argument("--out-dir", help="output dir (default <memory>/laya/export/)")
        p.add_argument("--stats", action="store_true", help="print the report only; write no files")
        p.add_argument("--min-lane", type=int, default=30, help="labeled lane rows needed for lane_ready")
        p.add_argument("--min-tier", type=int, default=30, help="labeled tier rows needed for tier_ready")
        return cmd_export(p.parse_args(argv[1:]))
    if argv and argv[0] == "outcome":
        p = argparse.ArgumentParser(prog="laya-route outcome")
        p.add_argument("--id", required=True)
        p.add_argument("--value", choices=["correct", "wrong-lane", "wrong-tdd", "wrong-context"])
        p.add_argument("--tier", choices=["tier-ok", "tier-too-low", "tier-too-high"],
                       help="was the coder model tier right? too-low = cheap failed/was reopened")
        p.add_argument("--model-used", help="model that actually produced the accepted result")
        p.add_argument("--attempts", type=int, help="coder attempts across tiers")
        p.add_argument("--escalated", action="store_true", help="a cheaper tier failed and the task moved up")
        p.add_argument("--note")
        oa = p.parse_args(argv[1:])
        if not (oa.value or oa.tier):
            p.error("give --value and/or --tier")
        return cmd_outcome(oa)
    p = argparse.ArgumentParser(prog="laya-route", description=__doc__.split("\n\n")[0])
    p.add_argument("--request-en", required=True, help="the request, in English (pins Laya's english checkpoint)")
    p.add_argument("--request", help="original wording, logged only")
    p.add_argument("--files", help="comma-separated paths expected/known to change")
    p.add_argument("--git-diff", nargs="?", const="", help="use changed+untracked files vs BASE (default HEAD)")
    p.add_argument("--task", help="task/ITER id, logged only")
    p.add_argument("--no-log", action="store_true")
    return cmd_route(p.parse_args(argv))


if __name__ == "__main__":
    main(sys.argv[1:])
